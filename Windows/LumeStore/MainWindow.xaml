<Window x:Class="LumeStore.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Lume Store">
  <Window.SystemBackdrop><MicaBackdrop Kind="BaseAlt"/></Window.SystemBackdrop>
  <Grid x:Name="Root" RequestedTheme="Dark">
    <Grid.Background><SolidColorBrush Color="#101226" Opacity="0.70"/></Grid.Background>
    <Grid.Resources>
      <Style TargetType="Button"><Setter Property="CornerRadius" Value="8"/><Setter Property="Padding" Value="14,9"/></Style>
    </Grid.Resources>
    <Grid.RowDefinitions><RowDefinition Height="48"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Grid x:Name="DragRegion" Margin="20,0,140,0"><StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center"><Image Source="ms-appx:///Assets/Lume.png" Width="26" Height="26"/><TextBlock Text="Lume Store" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center"/></StackPanel></Grid>
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions><ColumnDefinition Width="230"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Grid Padding="12,22,12,16" Background="#22122138">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBlock Text="CATÁLOGO" FontSize="10" CharacterSpacing="100" Foreground="#8192AB" Margin="16,0,0,18"/>
        <ListView x:Name="Navigation" Grid.Row="1" SelectionChanged="NavigationChanged" Background="Transparent" BorderThickness="0"/>
        <StackPanel Grid.Row="2" Spacing="10">
          <Button Content="&#xE713;   Configurações" FontFamily="Segoe UI" HorizontalAlignment="Stretch" Click="SettingsClicked"/>
        </StackPanel>
      </Grid>
      <Grid Grid.Column="1" Padding="34,12,34,20">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid Margin="0,0,0,24"><AutoSuggestBox x:Name="Search" Width="480" MaxWidth="600" HorizontalAlignment="Center" PlaceholderText="Pesquisar aplicativos no WinGet" QueryIcon="Find" QuerySubmitted="SearchSubmitted" AutomationProperties.Name="Pesquisar aplicativos"/><Button Content="&#xE72C;" FontFamily="Segoe Fluent Icons" HorizontalAlignment="Right" ToolTipService.ToolTip="Atualizar esta página" Click="RefreshClicked"/></Grid>
        <InfoBar x:Name="Notice" Grid.Row="1" IsOpen="False" IsClosable="True" Margin="0,0,0,12"/>
        <ScrollViewer x:Name="HomeScroll" Grid.Row="2" HorizontalScrollBarVisibility="Disabled"><StackPanel Spacing="20">
          <Grid><StackPanel Spacing="5"><TextBlock x:Name="Heading" Text="Descubra seu próximo favorito." FontSize="30" FontWeight="SemiBold"/><TextBlock x:Name="Subheading" Text="Ferramentas incríveis para fazer mais com o seu Windows." Foreground="#9CACBF" FontSize="14"/></StackPanel><ProgressRing x:Name="Busy" Width="26" Height="26" HorizontalAlignment="Right" IsActive="False"/></Grid>
          <Grid x:Name="FeaturedSection" Height="252">
            <FlipView x:Name="Featured" SelectionChanged="FeatureChanged" Background="Transparent" BorderThickness="0"/>
            <TextBlock x:Name="SlideLabel" Text="01 / 03" FontSize="12" CharacterSpacing="100" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,22,26,0" IsHitTestVisible="False"/>
          </Grid>
          <Grid x:Name="GridHeading"><TextBlock x:Name="SectionTitle" Text="Explore os aplicativos" FontSize="21" FontWeight="SemiBold"/><TextBlock x:Name="CountLabel" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="#93A6BE" FontSize="12"/></Grid>
          <TextBlock x:Name="EmptyLabel" Visibility="Collapsed" TextWrapping="Wrap" Foreground="#A9B8CB" Margin="0,25"/>
          <ItemsControl x:Name="Cards"><ItemsControl.ItemsPanel><ItemsPanelTemplate><ItemsWrapGrid Orientation="Horizontal" ItemWidth="292" ItemHeight="230" HorizontalAlignment="Left"/></ItemsPanelTemplate></ItemsControl.ItemsPanel></ItemsControl>
          <StackPanel x:Name="Transfers" Spacing="12" Visibility="Collapsed"/>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="12"><Button x:Name="Previous" Content="← Anteriores" Click="PreviousClicked" Visibility="Collapsed"/><Button x:Name="More" Content="Próximos aplicativos →" Click="MoreClicked" Visibility="Collapsed"/></StackPanel>
        </StackPanel></ScrollViewer>
        <Border x:Name="DetailsPage" Grid.Row="2" Visibility="Collapsed"><ScrollViewer HorizontalScrollBarVisibility="Disabled"><StackPanel x:Name="DetailsContent" Spacing="22" Padding="0,0,16,20"/></ScrollViewer></Border>
        <Grid Grid.Row="3" Margin="0,14,0,0"><TextBlock Text="LUME STORE" FontSize="10" CharacterSpacing="170" Foreground="#71839D"/><TextBlock x:Name="Status" Text="Conectando ao WinGet…" FontSize="11" Foreground="#71839D" HorizontalAlignment="Right"/></Grid>
      </Grid>
    </Grid>
  </Grid>
</Window>
